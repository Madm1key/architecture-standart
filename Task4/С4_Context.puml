@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(ccm, "Call center manager", "Advises customers")
Person_Ext(pccm, "Partner call center manager", "Advises customers")
System(app, "Bank System", "Processes customer requests, manages banking operations")
System(ccSystem, "Call center System", $descr="System for managing user requests")
System_Ext(pccSystem, "Partner call center System", $descr="System for managing user requests")

Rel(ccm, ccSystem, "Uses")
Rel(pccm, pccSystem, "Uses")
Rel(ccSystem, app, "Get deposit rates")
Rel_R(app, pccSystem, "Upload deposit rates file")

@enduml
